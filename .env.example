# Neo4j Knowledge Graph Configuration (Neo4j AuraDB Free Tier or Local Neo4j)
# For Neo4j AuraDB (Free): create a database at https://neo4j.com/cloud/platform/aura-graph-database/
# Copy the connection URI and password:
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-auradb-password>
NEO4J_DATABASE=neo4j

# Qdrant Vector Store Configuration
# By default runs locally in ./data/qdrant_db (zero cloud setup required).
# To use Qdrant Cloud: sign up at https://cloud.qdrant.io and paste URL and API Key:
QDRANT_PATH=./data/qdrant_db
QDRANT_URL=
QDRANT_API_KEY=

# LLM / Embedding Keys (Optional - Local Sentence Transformers are included out-of-the-box)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
OPENAI_API_KEY=
GEMINI_API_KEY=

